    <!-- Primer arranque -->
    <string name="onboarding_title">First run</string>
    <string name="onboarding_intro">FOUR STEPS. YOU CAN SKIP THEM AND COME BACK FROM SETTINGS (LONG-PRESS THE CLOCK).</string>
    <string name="onboarding_step1_title">1 · HOME APP</string>
    <string name="onboarding_step1_text">So the home button opens Usos.</string>
    <string name="onboarding_pick_home">SET USOS AS HOME</string>
    <string name="onboarding_step2_title">2 · ACCESSIBILITY</string>
    <string name="onboarding_step2_text">Lets Usos keep leisure apps frozen even when opened from a notification. It only detects which app opens; it does not read the screen. If Android shows it greyed out (\"restricted setting\", because the app was installed outside the store): App info &gt; ⋮ (top right) &gt; Allow restricted settings, then come back here.</string>
    <string name="onboarding_open_app_info">OPEN APP INFO</string>
    <string name="onboarding_open_accessibility">OPEN ACCESSIBILITY</string>
    <string name="onboarding_step3_title">3 · USAGE ACCESS</string>
    <string name="onboarding_step3_text">To show each app\'s usage time and storage.</string>
    <string name="onboarding_open_usage">OPEN USAGE ACCESS</string>
    <string name="onboarding_step4_title">4 · BATTERY</string>
    <string name="onboarding_battery_hint">So the system doesn\'t stop the service: %1$s Or App info &gt; Battery &gt; Unrestricted.</string>
    <string name="onboarding_battery_samsung">Battery &gt; Background usage limits &gt; Never sleeping apps &gt; add Usos.</string>
    <string name="onboarding_battery_xiaomi">App info &gt; Battery saver &gt; No restrictions, and enable autostart.</string>
    <string name="onboarding_battery_oppo">App info &gt; Battery usage &gt; Allow background activity.</string>
    <string name="onboarding_battery_huawei">Battery &gt; App launch &gt; Usos &gt; manage manually (everything on).</string>
    <string name="onboarding_battery_generic">Settings &gt; Apps &gt; Usos &gt; Battery &gt; Unrestricted.</string>
