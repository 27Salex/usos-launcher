    <string name="onboarding_title">Primer arranque</string>
    <string name="onboarding_intro">CUATRO PASOS. PUEDES SALTARLOS Y VOLVER DESDE AJUSTES (PULSACIÓN LARGA EN EL RELOJ).</string>
    <string name="onboarding_step1_title">1 · APP DE INICIO</string>
